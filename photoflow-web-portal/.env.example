# Salin file ini jadi .env, lalu isi nilainya secara lokal.
# JANGAN pernah commit .env yang sudah terisi.
# Di produksi, semua nilai di bawah diisi lewat Vercel Environment Variables.
#
# Catatan: prefix VITE_ membuat nilai ini ikut ter-bundle ke JavaScript
# yang dikirim ke browser. Jangan taruh secret apa pun di sini.

# URL project Supabase.
VITE_SUPABASE_URL=

# Anon/public key Supabase. Kunci ini memang untuk sisi klien,
# pengamanannya bergantung pada Row Level Security di Supabase.
VITE_SUPABASE_ANON_KEY=

# Alamat backend PhotoFlow. Boleh dikosongkan — kalau kosong, frontend memakai
# backend produksi (https://photoflow-backend.vercel.app), sehingga repo ini
# bisa di-clone lalu langsung dijalankan. Isi dengan http://localhost:8080
# untuk menjalankan frontend terhadap backend yang berjalan di mesin sendiri.
VITE_API_BASE=

# Alamat kontak yang ditampilkan di halaman /privacy dan /terms, untuk
# pertanyaan privasi dan permintaan penghapusan data. Boleh dikosongkan —
# selama kosong kedua dokumen menunjuk ke issue tracker repositori.
#
# WAJIB diisi sebelum aplikasi diajukan ke verifikasi OAuth Google: pengulas
# mereka membaca kebijakan privasi dan mencari cara menghubungi pemiliknya.
VITE_CONTACT_EMAIL=

# Nomor WhatsApp penjualan yang dipakai tombol di halaman /harga, dalam format
# 62xxxxxxxxxx tanpa tanda plus dan tanpa spasi.
#
# Kosong berarti tombol "Pesan lewat WhatsApp" TIDAK digambar sama sekali, dan
# kartu paket berbayar hanya menampilkan "Hubungi kami untuk berlangganan".
# Tombol yang membuka percakapan ke nomor yang tidak ada lebih merusak
# kepercayaan calon pembeli daripada tidak ada tombol.
#
# Nilainya diisi lewat Vercel, tidak pernah di-commit: nomor yang masuk repo
# publik ada selamanya di riwayat git dan dipanen dalam hitungan hari.
VITE_SALES_WHATSAPP=
