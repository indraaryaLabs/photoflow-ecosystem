# Salin file ini jadi .env, lalu isi nilainya secara lokal.
# JANGAN pernah commit .env yang sudah terisi.
# Di produksi, semua nilai di bawah diisi lewat Vercel Environment Variables.

# Connection string PostgreSQL (Supabase).
DATABASE_URL=

# Port HTTP yang didengarkan server Gin. Kosongkan untuk pakai default aplikasi.
PORT=

# API key Google, dipakai untuk pemanggilan Google Drive API.
GOOGLE_API_KEY=

# Client ID OAuth2 dari Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=

# Client secret OAuth2 dari Google Cloud Console.
GOOGLE_OAUTH_CLIENT_SECRET=

# URL callback OAuth2. Harus sama persis dengan yang didaftarkan di Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URL=

# Isi service account key Google Drive dalam bentuk JSON satu baris.
GDRIVE_CREDENTIALS_JSON=
