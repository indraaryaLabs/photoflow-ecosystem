# Salin file ini jadi .env, lalu isi nilainya secara lokal.
# JANGAN pernah commit .env yang sudah terisi.
# Di produksi, semua nilai di bawah diisi lewat Vercel Environment Variables.

# Connection string PostgreSQL (Supabase).
DATABASE_URL=

# Base URL project Supabase, contoh bentuknya https://<ref>.supabase.co
# Dipakai untuk memverifikasi JWT: issuer yang diharapkan diturunkan dari sini,
# dan kunci publiknya diambil dari <URL>/auth/v1/.well-known/jwks.json
# Bukan secret, tapi wajib diisi — server menolak menyala tanpa ini.
SUPABASE_URL=

# Port HTTP yang didengarkan server Gin. Kosongkan untuk pakai default aplikasi.
PORT=

# Client ID OAuth2 dari Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=

# Client secret OAuth2 dari Google Cloud Console.
GOOGLE_OAUTH_CLIENT_SECRET=

# URL callback OAuth2. Harus sama persis dengan yang didaftarkan di Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URL=

# API key Google Drive, dari Credentials di Google Cloud Console.
#
# Dipakai membaca folder yang dibagikan "Anyone with the link" TANPA OAuth sama
# sekali. Itu jalur utama sekarang, karena begitulah cara fotografer memang
# membagikan foldernya. Kredensial OAuth di atas tetap dipakai, tapi hanya
# sebagai cadangan untuk folder yang tidak publik.
#
# Kosong berarti setiap folder ditempuh lewat OAuth seperti sebelumnya —
# aplikasi tetap berjalan penuh, hanya kehilangan jalur yang lebih cepat dan
# yang bebas dari kedaluwarsa refresh token tujuh harian.
#
# Batasi key-nya ke Google Drive API saja di Cloud Console. Key ini tidak dapat
# membuka apa pun yang tidak sudah publik, tapi tanpa pembatasan itu ia bisa
# dipakai memanggil seluruh API lain yang aktif di project Anda.
GOOGLE_API_KEY=

# OPSIONAL. Nama header yang dipakai untuk menentukan IP klien pada rate
# limiting. Kosongkan untuk memakai urutan bawaan (x-vercel-forwarded-for lalu
# x-real-ip). Isi hanya setelah membuktikan header mana yang benar-benar diset
# platform lewat GET /api/debug/client-ip.
CLIENT_IP_HEADER=

# OPSIONAL. Setel ke 1 untuk mengaktifkan GET /api/debug/client-ip sementara.
# Endpoint itu membalas 404 kalau tidak diisi. Matikan lagi setelah selesai.
DEBUG_CLIENT_IP=

# OPSIONAL. Daftar alamat frontend yang boleh memanggil API ini, dipisah koma.
# Kosong berarti memakai bawaan di middleware/cors.go.
#
# INI YANG HARUS DIISI LEBIH DULU sebelum mengganti alamat frontend. Origin
# yang tidak terdaftar berarti setiap panggilan API ditolak peramban, dan yang
# terlihat bukan pesan error melainkan galeri kosong serta dashboard yang gagal
# memuat. Selama masa peralihan, isi keduanya sekaligus.
#
# Contoh: https://photoflow.vercel.app,https://photoflow-ecosystem.vercel.app
ALLOWED_ORIGINS=

# OPSIONAL. Alamat aplikasi web, dipakai menyusun tautan di dalam email
# pemberitahuan. Kosong berarti tautannya dilewati — emailnya tetap terkirim,
# hanya tanpa tombol menuju dashboard.
#
# Contoh: https://photoflow.vercel.app
APP_BASE_URL=

# OPSIONAL. Pemberitahuan email saat klien mengirim pilihannya. Keduanya harus
# terisi; salah satu kosong berarti fitur ini mati dan aplikasi tetap berjalan
# penuh tanpanya.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=

# OPSIONAL. Daftar user id yang boleh membuka rute /api/admin, dipisah koma.
#
# Dipakai untuk mengaktifkan langganan setelah pembeli mentransfer, dan untuk
# membangkitkan kode tebus. Isinya UUID dari Supabase Auth, bukan alamat email.
#
# KOSONG BERARTI TIDAK ADA YANG ADMINISTRATOR: seluruh rute /api/admin membalas
# 404. Itu disengaja — variabel yang lupa diisi tidak boleh berubah jadi rute
# tanpa penjaga.
#
# Disimpan di environment, bukan sebagai kolom peran di database, karena peran
# yang tersimpan di database dapat diubah siapa pun yang berhasil menulis ke
# sana. Environment hanya dapat diubah lewat dashboard hosting.
ADMIN_USER_IDS=
